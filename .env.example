# ─────────────────────────────────────────────────────────────────────────────
# MacroClaw Environment Configuration
# Copy to .env and fill in your credentials.
# NEVER commit .env to version control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# MacroClaw supports three LLM providers. Set ONE of the keys below.
# Auto-detection priority: DEERAPI_KEY > ANTHROPIC_API_KEY > OPENAI_API_KEY
# Override with LLM_PROVIDER=deerapi|anthropic|openai (optional).

# Option A — DeerAPI (https://deerapi.com) — OpenAI + Anthropic gateway
DEERAPI_KEY=your_deerapi_key_here
DEERAPI_BASE_URL=https://api.deerapi.com

# Option B — Anthropic API (https://console.anthropic.com)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option C — OpenAI API (https://platform.openai.com)
# OPENAI_API_KEY=your_openai_api_key_here

# Explicit provider override (optional — usually auto-detected from key presence)
# LLM_PROVIDER=deerapi

# ── Model ─────────────────────────────────────────────────────────────────────
# Default: claude-opus-4-6 (Anthropic/DeerAPI), gpt-4o (OpenAI)
# MACROCLAW_MODEL=claude-opus-4-6

# ── Agent Settings ───────────────────────────────────────────────────────────
# MACROCLAW_MAX_TOKENS=8192
# MACROCLAW_MAX_TURNS=10

# ── Geopolitical News Sources ─────────────────────────────────────────────────
# NewsAPI key — https://newsapi.org (free tier: 100 req/day)
# Optional: GDELT requires no key and is the primary source.
# NEWS_API_KEY=your_newsapi_key_here

# ── Commodity Data Sources ───────────────────────────────────────────────────
# Alpha Vantage key — https://www.alphavantage.co (free tier: 25 req/day)
# Optional: yfinance requires no key and is the primary source.
# ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# FRED (Federal Reserve Economic Data) key — https://fred.stlouisfed.org
# Optional: used for macroeconomic indicators.
# FRED_API_KEY=your_fred_api_key_here

# ── Memory ───────────────────────────────────────────────────────────────────
# MACROCLAW_MEMORY_ENABLED=true
# MACROCLAW_MEMORY_PATH=~/.macroclaw/memory

# ── Logging ──────────────────────────────────────────────────────────────────
# MACROCLAW_LOG_LEVEL=INFO
# MACROCLAW_LOG_FILE=~/.macroclaw/macroclaw.log
